---
import ProductGrid from "../../islands/ProductGrid";
import Base from "../../layouts/Base.astro";
import { catalog } from "../../lib/catalog";

const { products, categories } = await catalog();
---
<Base title="Producten">
  <h1>Producten</h1>
  {categories.length > 0 && (
    <nav class="categories">{categories.filter((c) => !c.parent).map((c) => <a href={`/categorie/${c.slug}/`}>{c.name}</a>)}</nav>
  )}
  <ProductGrid client:idle initial={products} empty="Er staan nog geen producten in de winkel. Kom snel terug!" />
</Base>
