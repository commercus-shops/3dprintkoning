---
import ProductGrid from "../islands/ProductGrid";
import Base from "../layouts/Base.astro";
import { catalog } from "../lib/catalog";
import { shop } from "../shop.config";

const { products } = await catalog();
---
<Base>
  <section class="hero">
    <h1>{shop.name}</h1>
    <p class="tagline">{shop.tagline}</p>
    <p>
      Unieke 3D-geprinte modellen: figuren, gadgets en onderdelen, op bestelling geprint in de kleur
      en het materiaal dat jij kiest.
    </p>
    <p>Kies je model, je kleur en je maat: we printen het voor je en sturen het naar je toe.</p>
  </section>
  <section>
    <ProductGrid client:idle initial={products} limit={shop.featured} heading="Uitgelicht" more={{ href: "/producten/", label: "Alle producten →" }} />
  </section>
</Base>
