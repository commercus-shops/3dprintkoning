---
import ProductGrid from "../../islands/ProductGrid";
import Base from "../../layouts/Base.astro";
import { catalog } from "../../lib/catalog";

export async function getStaticPaths() {
  const { categories, products } = await catalog();
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category, products: products.filter((p) => p.categories.includes(category.slug)) },
  }));
}

const { category, products } = Astro.props;
---
<Base title={category.name} description={category.description ?? undefined}>
  <h1>{category.name}</h1>
  {category.description && <p>{category.description}</p>}
  <ProductGrid client:idle initial={products} category={category.slug} empty="Hier staan nog geen producten." />
</Base>
